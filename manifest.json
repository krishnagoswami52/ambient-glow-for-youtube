{
  "manifest_version": 3,
  "name": "Ambient Glow for YouTube",
  "short_name": "Ambient Glow",
  "version": "1.1.0",
  "description": "Lights the YouTube watch page with the video's colours in real time, like a room lit by the screen. Not affiliated with YouTube.",
  "minimum_chrome_version": "100",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Ambient Glow for YouTube",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "defaults.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
